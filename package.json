{
  "name": "nodra",
  "version": "0.1.0",
  "description": "A metadata-driven web framework inspired by Frappe, built on Node.js + TypeScript + PostgreSQL",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nodra": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "keywords": [
    "framework",
    "metadata-driven",
    "doctype",
    "orm",
    "rest-api",
    "postgresql"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/argon2": "^0.15.4",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.2",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "@types/xlsx": "^0.0.36",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "simple-git-hooks": "^2.9.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/websocket": "^11.2.0",
    "argon2": "^0.44.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "fastify": "^5.7.4",
    "json2csv": "6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "pino": "^10.3.0",
    "ws": "^8.19.0",
    "xlsx": "^0.18.5"
  }
}
